<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

    <PackageId>ChronoScheduler.Cron</PackageId>
    <Description>Cron expression trigger for ChronoScheduler. Adds .WithCron("0 */2 * * *") to the fluent API.</Description>
    <PackageTags>scheduler;cron;chronoscheduler</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChronoScheduler\ChronoScheduler.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Cronos" />
  </ItemGroup>

</Project>
