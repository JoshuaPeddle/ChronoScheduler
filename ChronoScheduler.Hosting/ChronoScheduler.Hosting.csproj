<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

    <PackageId>ChronoScheduler.Hosting</PackageId>
    <Description>Microsoft.Extensions.Hosting integration for ChronoScheduler. Adds services.AddChronoScheduler() for ASP.NET Core and Generic Host apps.</Description>
    <PackageTags>scheduler;hosting;aspnetcore;chronoscheduler</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChronoScheduler\ChronoScheduler.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

</Project>
